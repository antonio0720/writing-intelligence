{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writing-intelligence.dev/schemas/v8/fiction_gate.schema.json",
  "title": "WI fiction release gate",
  "description": "The verdict of the three-stage fiction release gate (draft, editorial, publication). Eligibility is not publication; publication holds without independent reader evidence.",
  "type": "object",
  "required": [
    "schema",
    "mode",
    "input_digest",
    "policy_digest",
    "verdict",
    "issues"
  ],
  "properties": {
    "schema": {
      "const": "wi.fiction.gate/v1"
    },
    "mode": {
      "enum": [
        "draft",
        "editorial",
        "publication"
      ]
    },
    "verdict": {
      "enum": [
        "BLOCK",
        "HOLD",
        "ELIGIBLE_FOR_HUMAN_DECISION",
        "DRAFT_CHECKS_COMPLETE"
      ]
    },
    "issues": {
      "type": "array"
    }
  }
}
